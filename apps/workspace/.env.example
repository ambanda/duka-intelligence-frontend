DUKA_API_BASE_URL=https://api.dukaintelligence.co.ke
NEXT_PUBLIC_DUKA_WEBSITE_URL=https://dukaintelligence.co.ke
WORKSPACE_APP_URL=https://app.dukaintelligence.co.ke
WORKSPACE_AUTH_MODE=oidc
WORKSPACE_SESSION_SECRET=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://app.dukaintelligence.co.ke/auth/callback
OIDC_SCOPE=openid profile email offline_access
OIDC_AUDIENCE=
WORKSPACE_SESSION_MAX_AGE_SECONDS=28800

# Local development only. Ignored when NODE_ENV=production.
DUKA_DEV_PRINCIPAL_ID=principal_local_admin
DUKA_DEV_PRINCIPAL_EMAIL=admin@example.com
DUKA_DEV_PRINCIPAL_NAME=Local Workspace Admin
DUKA_DEV_TENANT_ID=tenant_local
DUKA_DEV_CLIENT_ID=client_local
DUKA_DEV_WORKSPACE_ID=workspace_local
DUKA_DEV_WORKSPACE_SLUG=demo-workspace
DUKA_DEV_WORKSPACE_NAME=Demo Workspace
DUKA_DEV_ORGANIZATION_ID=organization_local
DUKA_DEV_SECTOR=sacco
DUKA_DEV_SHOP_ID=default
DUKA_DEV_ROLE=workspace_admin
DUKA_DEV_PERMISSION_SET=workspace_manage
